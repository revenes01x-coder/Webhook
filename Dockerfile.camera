# ใช้ Python 3.11 slim
FROM python:3.11-slim-bookworm

# ตั้งค่า Working Directory
WORKDIR /app

# ติดตั้ง System dependencies ที่จำเป็นสำหรับไลบรารีประมวลผลภาพ (OpenCV, etc.)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# คัดลอก requirements และติดตั้งแพ็กเกจของกล้อง
COPY requirements.txt .
COPY requirements-camera.txt .
RUN pip install --no-cache-dir -r requirements-camera.txt

# คัดลอกโค้ดทั้งหมด (รวมโมเดล yolo11n.pt) เข้ามาใน Container
COPY . .

# คำสั่งเริ่มต้นสำหรับรัน Camera Manager
CMD ["python", "camera/camera_manager.py"]